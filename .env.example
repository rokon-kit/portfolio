# Public canonical URL of the deployed site. Used for metadataBase, canonical links,
# Open Graph URLs and the sitemap. Defaults to the existing portfolio host if unset.
NEXT_PUBLIC_SITE_URL=https://rokonuzzaaman.web.app

# Development tool only. Set to "true" at BUILD time to include the /lab/system scene laboratory in a
# production build (used for QA against an optimised build). Leave unset for real deployments: the
# route then returns 404.
# ENABLE_SCENE_LAB=true
